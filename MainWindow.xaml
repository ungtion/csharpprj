<Window x:Class="CSharpProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备监控中心"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F1F4F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5EAF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#253248" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8290A3" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C3CBD6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavigationBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="#24423F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageContentStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="28,20,28,24" />
            <Setter Property="MaxWidth" Value="1480" />
        </Style>
        <Style x:Key="DisabledControlButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#738197" />
            <Setter Property="Background" Value="#F3F5F8" />
            <Setter Property="BorderBrush" Value="#E1E6ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="IsEnabled" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" /><!-- 第 0 列：固定 250 像素（侧边栏） -->
            <ColumnDefinition Width="*" /><!-- 第 1 列：占剩余全部（主内容区） -->
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172337"><!-- 侧边栏 -->
            <DockPanel Margin="18,22" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,2,0,32">
                        <Border Width="38" Height="38" CornerRadius="7" Background="#168B83">
                            <TextBlock Text="" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="设备监控中心" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="INDUSTRIAL HMI" Foreground="#91A0B4" FontSize="9" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="监控导航" Foreground="#8493A8" FontSize="10" Margin="10,0,0,8" />
                    <Button x:Name="OverviewNavButton" Style="{StaticResource NavigationButtonStyle}"
                            Background="#24423F" Foreground="White" Click="OverviewNavClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" Foreground="#58D0B5" FontSize="15" Width="26" />
                            <TextBlock Text="设备总览"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NewFileNavButton" Style="{StaticResource NavigationButtonStyle}"
                            Click="NewFileNavClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" Foreground="#58D0B5" FontSize="15" Width="26" />
                            <TextBlock Text="NewFile"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RealtimeNavButton" Style="{StaticResource NavigationButtonStyle}"
                            Click="RealtimeNavClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◷" Foreground="#AAB6C5" FontSize="15" Width="26" />
                            <TextBlock Text="实时监控"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RecipeNavButton" Style="{StaticResource NavigationButtonStyle}"
                            Click="RecipeNavClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◀" Foreground="#AAB6C5" FontSize="15" Width="26" />
                            <TextBlock Text="bake"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AlarmNavButton" Style="{StaticResource NavigationButtonStyle}"
                            Click="AlarmNavClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚑" Foreground="#AAB6C5" FontSize="15" Width="26" />
                            <TextBlock Text="报警记录"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SystemNavButton" Style="{StaticResource NavigationButtonStyle}"
                            Margin="0" Click="SystemNavClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Foreground="#AAB6C5" FontSize="15" Width="26" />
                            <TextBlock Text="系统信息"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#202F44" CornerRadius="7" Padding="12">
                    <StackPanel>
                        <TextBlock Text="运行环境" Foreground="#91A0B4" FontSize="10" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <TextBlock Text="●" Foreground="#B3E0E3" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="  仿真模式" Foreground="#E0E7EF" FontSize="11" />
                        </StackPanel>
                        <TextBlock Text="未连接 PLC / 控制器" Foreground="#91A0B4" FontSize="10"
                                   Margin="0,7,0,0" />
                        <TextBlock Text="test" Foreground="#91A0B4" FontSize="10" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="#F1F4F8"><!-- 右侧内容 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="58" /><!-- 第 0 行：顶栏，固定 58 -->
                <RowDefinition Height="*" /> <!-- 第 1 行：页面内容，占剩余高度 -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1">
                <Grid Margin="24,0" MaxWidth="1480">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="设备管理" Foreground="#8995A5" FontSize="11" />
                        <TextBlock Text="  /  " Foreground="#B4BECA" FontSize="11" />
                        <TextBlock x:Name="PageBreadcrumbText" Text="设备总览"
                                   Foreground="#344256" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="●" Foreground="#E5A83B" FontSize="9" VerticalAlignment="Center" />
                        <TextBlock Text=" 仿真数据" Foreground="#68778B" FontSize="11" Margin="0,0,20,0" />
                        <TextBlock x:Name="ClockText" Foreground="#536176" FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="OverviewPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Style="{StaticResource PageContentStyle}">
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="设备总览" Foreground="#253248" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="运行状态与关键工艺参数实时监控"
                                       Foreground="#8290A3" FontSize="11" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="设备编号" Foreground="#8290A3" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Background="White" BorderBrush="#DDE4EC" BorderThickness="1"
                                    CornerRadius="5" Padding="12,8">
                                <TextBlock Text="ST-01  单机测试站" Foreground="#344256" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}" Padding="18,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#E5F6F1">
                                    <TextBlock Text="●" Foreground="#159B78" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="设备运行正常" Foreground="#26364A" FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="所有监测点状态正常，当前为界面演示状态"
                                               Foreground="#8290A3" FontSize="10" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="最后更新：" Foreground="#8290A3" FontSize="10"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="UpdateTimeText" Foreground="#536176" FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                            <StackPanel>
                                <TextBlock Text="出料温度" Foreground="#718096" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock x:Name="TemperatureText" Text="42.6" Foreground="#26364A"
                                               FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text=" °C" Foreground="#718096" FontSize="11"
                                               VerticalAlignment="Bottom" Margin="2,0,0,5" />
                                </StackPanel>
                                <TextBlock Text="设定值 45.0 °C" Foreground="#98A3B2" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="3,0,6,0">
                            <StackPanel>
                                <TextBlock Text="管路压力" Foreground="#718096" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock x:Name="PressureText" Text="0.62" Foreground="#26364A"
                                               FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text=" MPa" Foreground="#718096" FontSize="11"
                                               VerticalAlignment="Bottom" Margin="2,0,0,5" />
                                </StackPanel>
                                <TextBlock Text="正常范围 0.40–0.80 MPa" Foreground="#98A3B2" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="6,0,3,0">
                            <StackPanel>
                                <TextBlock Text="主轴转速" Foreground="#718096" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock x:Name="SpeedText" Text="1480" Foreground="#26364A"
                                               FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text=" rpm" Foreground="#718096" FontSize="11"
                                               VerticalAlignment="Bottom" Margin="2,0,0,5" />
                                </StackPanel>
                                <TextBlock Text="额定转速 1500 rpm" Foreground="#98A3B2" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                            <StackPanel>
                                <TextBlock Text="设备稼动率" Foreground="#718096" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock x:Name="EfficiencyText" Text="98.6" Foreground="#26364A"
                                               FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text=" %" Foreground="#718096" FontSize="11"
                                               VerticalAlignment="Bottom" Margin="2,0,0,5" />
                                </StackPanel>
                                <TextBlock Text="本班次累计" Foreground="#98A3B2" FontSize="10" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,7,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="工艺流程状态" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="关键工位与执行单元" Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#E8F6F2"
                                            CornerRadius="4" Padding="8,5">
                                        <TextBlock Text="自动模式" Foreground="#16866F" FontSize="10" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" MinHeight="132">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="24" Background="#E4F5F1">
                                            <TextBlock Text="泵" Foreground="#158B76" FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="进料泵" Foreground="#344256" FontSize="11"
                                                   HorizontalAlignment="Center" Margin="0,8,0,2" />
                                        <TextBlock Text="运行中" Foreground="#159B78" FontSize="10"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="2" Background="#49B59A"
                                            VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="24" Background="#E4F5F1">
                                            <TextBlock Text="滤" Foreground="#158B76" FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="处理单元" Foreground="#344256" FontSize="11"
                                                   HorizontalAlignment="Center" Margin="0,8,0,2" />
                                        <TextBlock Text="运行中" Foreground="#159B78" FontSize="10"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Height="2" Background="#49B59A"
                                            VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="24" Background="#E4F5F1">
                                            <TextBlock Text="阀" Foreground="#158B76" FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="出料阀" Foreground="#344256" FontSize="11"
                                                   HorizontalAlignment="Center" Margin="0,8,0,2" />
                                        <TextBlock Text="开启" Foreground="#159B78" FontSize="10"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="2" Background="#F6F8FA" CornerRadius="5" Padding="10,8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="累计运行" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="06 h 32 min" Foreground="#344256" FontSize="11"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="当前批次" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="B-2026-1102" Foreground="#344256" FontSize="11"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="当前配方" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="标准工艺 A" Foreground="#344256" FontSize="11"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="设备状态" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="控制器与通讯概况" Style="{StaticResource MutedTextStyle}"
                                           Margin="0,4,0,12" />
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="运行模式" Foreground="#718096" FontSize="11" />
                                    <TextBlock Text="自动" Foreground="#344256" FontSize="11"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="PLC 通讯" Foreground="#718096" FontSize="11" />
                                    <TextBlock Text="仿真中" Foreground="#D2942F" FontSize="11"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="#E9EDF2" Margin="0,2,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="串口（COM）扫描" Foreground="#344256" FontSize="11"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Content="扫描" Click="ScanPortsClick"
                                                Padding="10,4" Margin="0,0,6,0"
                                                Background="#E8F6F2" Foreground="#16866F"
                                                BorderThickness="0" FontSize="10" Cursor="Hand" />
                                        <Button Content="xx" Click="ScanxxClick"
                                                Padding="10,4"
                                                Background="#E8F6F2" Foreground="#16866F"
                                                BorderThickness="0" FontSize="10" Cursor="Hand" />
                                        <Button Content="xxx" Click="ScanxxxsClick"
                                                Padding="10,4"
                                                Background="#E8F6F2" Foreground="#16866F"
                                                BorderThickness="0" FontSize="10" Cursor="Hand" />
                                    </StackPanel>
                                </Grid>
                                <ComboBox x:Name="PortComboBox" Height="30" FontSize="10"
                                          IsEditable="False" ToolTip="选择系统检测到的串口" />
                                <TextBlock x:Name="PortScanStatusText" Text="正在读取串口信息…"
                                           Foreground="#8290A3" FontSize="9" Margin="0,6,0,10"
                                           TextWrapping="Wrap" />
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="安全门" Foreground="#718096" FontSize="11" />
                                    <TextBlock Text="已关闭" Foreground="#159B78" FontSize="11"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="急停回路" Foreground="#718096" FontSize="11" />
                                    <TextBlock Text="正常" Foreground="#159B78" FontSize="11"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="#E9EDF2" Margin="0,0,0,12" />
                                <TextBlock Text="操作面板（演示）" Foreground="#344256" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,0,0,9" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="启动设备" Style="{StaticResource DisabledControlButtonStyle}" />
                                    <Button Content="停止设备" Style="{StaticResource DisabledControlButtonStyle}" />
                                    <Button Content="报警复位" Style="{StaticResource DisabledControlButtonStyle}"
                                            Margin="0" />
                                </StackPanel>
                                <TextBlock Text="演示界面未连接真实设备，操作不可用"
                                           Foreground="#9AA5B3" FontSize="9" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,7,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="工艺参数趋势" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="出料温度 · 最近 30 分钟" Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="42.6 °C" Foreground="#168B83" FontSize="13"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Height="140">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="50" Foreground="#A1ACB9" FontSize="9"
                                                   VerticalAlignment="Top" />
                                        <Border Height="1" Background="#EEF1F4" Margin="24,5,0,0"
                                                VerticalAlignment="Top" />
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <TextBlock Text="40" Foreground="#A1ACB9" FontSize="9"
                                                   VerticalAlignment="Center" />
                                        <Border Height="1" Background="#EEF1F4" Margin="24,0,0,0"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <TextBlock Text="30" Foreground="#A1ACB9" FontSize="9"
                                                   VerticalAlignment="Bottom" />
                                        <Border Height="1" Background="#EEF1F4" Margin="24,0,0,5"
                                                VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Polyline Points="35,75 90,67 145,72 200,50 255,56 310,38 365,45 420,30 475,36 530,22"
                                              Stroke="#159B8A" StrokeThickness="2" Stretch="Fill"
                                              Margin="28,5,4,7" />
                                </Grid>
                                <Grid Margin="26,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="10:00" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="10:10" Style="{StaticResource MutedTextStyle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="10:20" Style="{StaticResource MutedTextStyle}"
